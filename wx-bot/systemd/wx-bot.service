[Unit]
Description=wx-bot WeChat bridge for Muse
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
Environment=HOME=/home/hatch
WorkingDirectory=/home/hatch
EnvironmentFile=%h/.config/wx-bot/env
ExecStart=%h/.local/bin/wx-bot run
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
